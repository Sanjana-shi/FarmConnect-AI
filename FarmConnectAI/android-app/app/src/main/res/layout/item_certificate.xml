<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="#CBD5E1"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎖️ VERIFIED WORK CERTIFICATE"
                android:textColor="#059669"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_cert_grade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="GRADE A+"
                android:textColor="#15803D"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_cert_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Paddy Harvesting &amp; Threshing"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cert_farmer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Issued by Murugan Farms • Thanjavur, Tamil Nadu"
            android:textColor="#475569"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_cert_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Duration: 4 Days (12-15 Aug 2026) • ⭐ 5.0 Rating"
            android:textColor="#0284C7"
            android:textSize="12sp" />

        <!-- Testimonial Quote -->
        <TextView
            android:id="@+id/tv_cert_testimonial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#F8FAFC"
            android:padding="10dp"
            android:text="&quot;Exceptional punctuality and careful machine handling. Completed 3.5 acres harvesting ahead of scheduled rain with zero grain loss.&quot;"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- Cryptographic Hash -->
        <TextView
            android:id="@+id/tv_cert_hash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="🔒 SHA-256: 8f9b2c3a10e47d...92e10"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_cert"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/primary_green"
            android:text="Verify &amp; Share Certificate"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
