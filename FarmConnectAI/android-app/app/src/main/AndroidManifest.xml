<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.farmconnect.app">

    <!-- Network Permissions for Spring Boot REST API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location Permissions for Rural Geolocation & Matching -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Audio / Speech for Multilingual Voice Assistant -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FarmConnectAI"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Launcher: Language Selection Screen -->
        <activity
            android:name=".auth.LanguageActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.OtpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".farmer.FarmerDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".farmer.WorkforcePlannerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".farmer.TrustedWorkersActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".farmer.UrgentWorkforceActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".worker.WorkerDashboardActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".worker.SkillPassportActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".worker.WorkCertificatesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".common.WorkerTeamsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".common.JobMessagingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".common.StructuredRatingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".common.AiInsightsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".common.ConnectionDiagnosticActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
